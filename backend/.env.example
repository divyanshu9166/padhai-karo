# Server-side-only environment variables. NEVER bundle these into the mobile client.
# Copy to .env.local for local development. DATABASE_URL is required; the feature-provider
# variables are optional and are exposed as capability flags by GET /api/health. These are
# server-only secrets and must never be shipped via the client OTA bundle.

# Database (PostgreSQL via Prisma datasource `DATABASE_URL`) - task 1.2 / 1.3
DATABASE_URL=postgresql://user:password@localhost:5432/jee_neet_study

# Redis (BullMQ queues + session cache) - task 1.2
REDIS_URL=redis://localhost:6379

# AI provider (Gemini / Claude, vision-capable) - used by AI notes (task 16) + extraction (task 12)
AI_PROVIDER_API_KEY=
AI_PROVIDER=GROQ
AI_PROVIDER_MODEL=openai/gpt-oss-20b
AI_PROVIDER_VISION_MODEL=qwen/qwen3.6-27b
# Groq free-tier setup: create a key at console.groq.com and keep it server-side.
# Text uses the production GPT-OSS model. Vision currently uses a Groq preview model,
# so keep the local/extractive fallback enabled and review model deprecation notices.
TRANSCRIPTION_API_URL=
TRANSCRIPTION_PROVIDER_API_KEY=
# TRANSCRIPTION_API_URL accepts the app's generic JSON contract: { audioBase64, mimeType,
# language } -> { text } or { transcript }.
# Optional comma-separated overrides: sourceName|https-url|UPSC_CSE or SSC_CGL.
# Blank uses verified PIB RSS defaults for both exam tracks.
CURRENT_AFFAIRS_FEEDS=
CURRENT_AFFAIRS_CRON_SECRET=
BRIEFING_CRON_SECRET=
PUSH_CRON_SECRET=
# Vercel Cron sends Authorization: Bearer $CRON_SECRET automatically. The
# feature-specific secrets above remain supported for other schedulers.
CRON_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_APP_RETURN_URI=padhaikaro://calendar/google/callback
CALENDAR_TOKEN_ENCRYPTION_KEY=
CALENDAR_CRON_SECRET=
COACHING_PROVIDER_URL=
COACHING_PROVIDER_API_KEY=
PYQ_IMPORT_KEY=
MODERATION_KEY=
# Optional overrides; defaults are CC BY 4.0 Google sound-library ambience/hum URLs.
AMBIENT_RAIN_URL=
AMBIENT_BROWN_NOISE_URL=

# Native visual PDF page rendering. Use `pdftoppm` on Linux/macOS or `pdftoppm.cmd`
# when the Windows Poppler wrapper is on PATH. A deployment may set an absolute path.
PDF_RENDERER_BIN=pdftoppm

# Run `npm run worker:scheduler` as a long-lived worker, or invoke the secret-gated cron
# endpoints from your deployment scheduler. A server process alone cannot create a remote cron.

# Razorpay (subscription payments + webhook signature verification) - task 16
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
