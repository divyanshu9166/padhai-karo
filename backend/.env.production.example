# Copy to .env.production and provide real deployment values. Never commit the populated file.
# For the bundled single-VPS stack (`docker-compose.vps.yml`), keep these hostnames as
# `postgres` and `redis`; the compose file injects the final connection strings. Use a
# strong alphanumeric password so it is safe inside the generated PostgreSQL URL.
API_DOMAIN=api.example.com
POSTGRES_DB=padhaikaro
POSTGRES_USER=padhaikaro
POSTGRES_PASSWORD=replace-with-a-long-alphanumeric-password
DATABASE_URL=postgresql://padhaikaro:replace-with-a-long-alphanumeric-password@postgres:5432/padhaikaro?schema=public
REDIS_URL=redis://redis:6379
CRON_SECRET=replace-with-a-long-random-secret
PDF_RENDERER_BIN=pdftoppm
# Optional live providers; the app remains usable with rule-based/local fallbacks.
AI_PROVIDER=GROQ
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=openai/gpt-oss-20b
AI_PROVIDER_VISION_MODEL=qwen/qwen3.8-27b
TRANSCRIPTION_API_URL=
TRANSCRIPTION_PROVIDER_API_KEY=
TRANSCRIPTION_PROVIDER_MODEL=whisper-large-v3-turbo
# Leave blank for automatic language detection, or set the transcription provider's language code.
TRANSCRIPTION_LANGUAGE=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
CALENDAR_TOKEN_ENCRYPTION_KEY=
COACHING_PROVIDER_URL=
COACHING_PROVIDER_API_KEY=
PUSH_CRON_SECRET=
BRIEFING_CRON_SECRET=
CURRENT_AFFAIRS_CRON_SECRET=
CALENDAR_CRON_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Transactional email for password-reset codes. Only RESEND is supported today.
# Without it, local dev prints codes to the server log; production returns 503 on reset.
EMAIL_PROVIDER=RESEND
EMAIL_API_KEY=
EMAIL_FROM="Padhai Karo <no-reply@yourdomain.in>"
